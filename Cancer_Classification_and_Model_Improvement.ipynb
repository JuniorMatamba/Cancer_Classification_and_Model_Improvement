**Importing the libraries and load the dataset**
It loads the data, imports the required tools and creates a readable diagnosis column. 


# Import libraries for data analysis, visualisation and modelling
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.datasets import load_breast_cancer
from sklearn.model_selection import (
    train_test_split, GridSearchCV, StratifiedKFold
)
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.feature_selection import SelectKBest, f_classif
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    accuracy_score, precision_score, recall_score, f1_score,
    roc_auc_score, confusion_matrix, classification_report,
    ConfusionMatrixDisplay, RocCurveDisplay
)

# Load the Wisconsin Diagnostic Breast Cancer dataset
dataset = load_breast_cancer(as_frame=True)

# Create a DataFrame containing the predictors
df = dataset.data.copy()

# Add a readable diagnosis column.
# In this dataset, target 0 means malignant and target 1 means benign.
df["diagnosis"] = dataset.target.map({
    0: "Malignant",
    1: "Benign"
})

# Display the first five records
display(df.head())

# Display the number of rows and columns
print("Dataset shape:", df.shape)


Conducting exploratory data analysis (EDA)


# Check the column names, data types and non-null counts
df.info()

# Examine descriptive statistics for numerical variables
display(df.describe().T)

# Count missing values in every column
print("Missing values per column:")
print(df.isnull().sum())

# Check for duplicate records
print("Duplicate rows:", df.duplicated().sum())

# Examine the distribution of diagnosis classes
print("\nDiagnosis counts:")
print(df["diagnosis"].value_counts())

print("\nDiagnosis percentages:")
print((df["diagnosis"].value_counts(normalize=True) * 100).round(2))


Creating the first two visualisations.


# Chart 1: Show the number of benign and malignant cases
sns.countplot(data=df, x="diagnosis")
plt.title("Distribution of Breast Cancer Diagnoses")
plt.xlabel("Diagnosis")
plt.ylabel("Number of cases")
plt.tight_layout()
plt.show()

# Chart 2: Compare selected measurements across diagnosis classes
selected_features = [
    "mean radius", "mean texture",
    "mean perimeter", "mean area"
]

fig, axes = plt.subplots(2, 2, figsize=(12, 8))

for feature, ax in zip(selected_features, axes.flatten()):
    sns.boxplot(
        data=df, x="diagnosis", y=feature, ax=ax
    )
    ax.set_title(f"{feature} by diagnosis")

plt.tight_layout()
plt.show()


Now Let's Next, examine relationships between features


# Calculate correlations between numerical measurements
correlation = dataset.data.corr()

# Plot a correlation heatmap
plt.figure(figsize=(14, 10))
sns.heatmap(
    correlation,
    cmap="coolwarm",
    center=0,
    xticklabels=False,
    yticklabels=False
)
plt.title("Correlation Heatmap of Numerical Features")
plt.tight_layout()
plt.show()


Cleanning the data and prepare the target because the dataset has no missing values listed in its source metadata.


# Work with the original numerical predictors
X = dataset.data.copy()

# Define malignant as the positive class (1) and benign as 0.
# This makes malignant-class recall easier to interpret.
y = (dataset.target == 0).astype(int)

# Check missing values in the predictors
print("Missing predictor values:", X.isnull().sum().sum())

# Check duplicate predictor rows
print("Duplicate predictor rows:", X.duplicated().sum())

# Check for infinite numerical values
print("Infinite values:", np.isinf(X.to_numpy()).sum())

# Remove exact duplicate predictor rows if any exist.
# Keep the first occurrence and apply the same selection to the target.
keep = ~X.duplicated()
X = X.loc[keep].copy()
y = y.loc[keep].copy()

# Confirm the cleaned dataset dimensions
print("Cleaned predictor shape:", X.shape)
print("Target shape:", y.shape)
print("Target counts (0=benign, 1=malignant):")
print(y.value_counts().sort_index())


Spliting the dataset into training and testing sets


# Keep 20% of the data aside for final testing.
# Stratification preserves the approximate class proportions.
X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("Training records:", len(X_train))
print("Testing records:", len(X_test))

print("\nTraining class proportions:")
print(y_train.value_counts(normalize=True).round(3))

print("\nTesting class proportions:")
print(y_test.value_counts(normalize=True).round(3))


**Trainnig the first classification model:**
The pipeline standardises the training measurements, selects 10 features and trains Logistic Regression. The fitted pipeline then applies the same learned transformations to the test data



# Create a pipeline so preprocessing and feature selection
# are learned from training data only.
baseline_model = Pipeline([
    ("scaler", StandardScaler()),
    ("selector", SelectKBest(score_func=f_classif, k=10)),
    ("classifier", LogisticRegression(
        max_iter=5000, random_state=42
    ))
])

# Train the baseline model
baseline_model.fit(X_train, y_train)

# Predict the diagnosis of unseen test records
baseline_predictions = baseline_model.predict(X_test)
baseline_probabilities = baseline_model.predict_proba(X_test)[:, 1]

# Display the features selected by ANOVA F-score
selected_mask = baseline_model.named_steps[
    "selector"
].get_support()

selected_features = X_train.columns[selected_mask]

print("Selected features:")
print(selected_features.tolist())


Evaluating the baseline model


# Calculate performance metrics for the baseline model
print("BASELINE MODEL RESULTS")
print("----------------------")

print("Accuracy:",
      round(accuracy_score(y_test, baseline_predictions), 4))

print("Precision (malignant):",
      round(precision_score(y_test, baseline_predictions), 4))

print("Recall (malignant):",
      round(recall_score(y_test, baseline_predictions), 4))

print("F1-score (malignant):",
      round(f1_score(y_test, baseline_predictions), 4))

print("ROC-AUC:",
      round(roc_auc_score(y_test, baseline_probabilities), 4))

# Print precision, recall and F1-score for both classes
print("\nDetailed classification report:")
print(classification_report(
    y_test,
    baseline_predictions,
    labels=[0, 1],
    target_names=["Benign", "Malignant"],
    zero_division=0
))

# Plot the confusion matrix
ConfusionMatrixDisplay.from_predictions(
    y_test,
    baseline_predictions,
    labels=[0, 1],
    display_labels=["Benign", "Malignant"],
    cmap="Blues"
)
plt.title("Baseline Model Confusion Matrix")
plt.tight_layout()
plt.show()

# Plot the ROC curve
RocCurveDisplay.from_predictions(
    y_test, baseline_probabilities
)
plt.title("Baseline Model ROC Curve")
plt.tight_layout()
plt.show()


Improving the model using different parameters

The grid search tests 24 parameter combinations, using five-fold cross-validation on the training data. The final model is then evaluated on the held-out test set.


# Define stratified cross-validation using only training data
cv = StratifiedKFold(
    n_splits=5, shuffle=True, random_state=42
)

# Build a model pipeline that can test different settings
improved_pipeline = Pipeline([
    ("scaler", StandardScaler()),
    ("selector", SelectKBest(score_func=f_classif)),
    ("classifier", LogisticRegression(
        max_iter=5000, random_state=42
    ))
])

# Test different numbers of features, regularisation strengths
# and class-weight settings.
# Recall is used for model selection because malignant cases
# are important to identify.
parameter_grid = {
    "selector__k": [5, 10, 15, "all"],
    "classifier__C": [0.1, 1, 10],
    "classifier__class_weight": [None, "balanced"]
}

# Search for the best combination using cross-validation
grid_search = GridSearchCV(
    estimator=improved_pipeline,
    param_grid=parameter_grid,
    scoring="recall",
    cv=cv,
    n_jobs=-1,
    refit=True
)

grid_search.fit(X_train, y_train)

# Show the best configuration and its cross-validation recall
print("Best parameters:")
print(grid_search.best_params_)

print("Best cross-validation recall:",
      round(grid_search.best_score_, 4))

# Evaluate the selected model once on the held-out test set
improved_model = grid_search.best_estimator_
improved_predictions = improved_model.predict(X_test)
improved_probabilities = improved_model.predict_proba(X_test)[:, 1]

print("\nIMPROVED MODEL RESULTS")
print("----------------------")
print("Accuracy:",
      round(accuracy_score(y_test, improved_predictions), 4))
print("Precision:",
      round(precision_score(y_test, improved_predictions), 4))
print("Recall:",
      round(recall_score(y_test, improved_predictions), 4))
print("F1-score:",
      round(f1_score(y_test, improved_predictions), 4))
print("ROC-AUC:",
      round(roc_auc_score(y_test, improved_probabilities), 4))

print("\nClassification report:")
print(classification_report(
    y_test,
    improved_predictions,
    labels=[0, 1],
    target_names=["Benign", "Malignant"],
    zero_division=0
))

ConfusionMatrixDisplay.from_predictions(
    y_test,
    improved_predictions,
    labels=[0, 1],
    display_labels=["Benign", "Malignant"],
    cmap="Blues"
)
plt.title("Improved Model Confusion Matrix")
plt.tight_layout()
plt.show()


Creating a comparison table


# Summarise the two models using the same test set
results = pd.DataFrame({
    "Metric": [
        "Accuracy", "Precision", "Recall", "F1-score", "ROC-AUC"
    ],
    "Baseline": [
        accuracy_score(y_test, baseline_predictions),
        precision_score(y_test, baseline_predictions),
        recall_score(y_test, baseline_predictions),
        f1_score(y_test, baseline_predictions),
        roc_auc_score(y_test, baseline_probabilities)
    ],
    "Improved": [
        accuracy_score(y_test, improved_predictions),
        precision_score(y_test, improved_predictions),
        recall_score(y_test, improved_predictions),
        f1_score(y_test, improved_predictions),
        roc_auc_score(y_test, improved_probabilities)
    ]
})

results["Baseline"] = results["Baseline"].round(4)
results["Improved"] = results["Improved"].round(4)

display(results)

# Save the results for use in the report
results.to_csv("model_comparison.csv", index=False)
